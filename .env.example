# Browser-safe keys only. Never put a Supabase service-role key or AI provider key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# AI keys belong in Supabase Edge Function secrets, NOT VITE_ variables.
# Set with: supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=gemini-2.5-flash
